[Unit]
Description=Cricket Score Notifier (Telegram)
# Wait for real network connectivity before starting (the first thing the app
# does is call Telegram and the cricket API).
After=network-online.target
Wants=network-online.target

# Restart throttling: with RestartSec=30s below, allow up to 5 failed starts
# within 5 minutes before giving up. The window MUST exceed RestartSec*Burst
# (30s*5=150s) or the counter never fills and the service loops forever — the
# previous 10s default window was why the crash-loop never self-arrested.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=jcube
WorkingDirectory=/home/jcube/projects/cricket-notifier
# Loads BOT_TOKEN, CHAT_ID and RAPIDAPI_KEY into the process environment.
EnvironmentFile=/home/jcube/projects/cricket-notifier/.env
ExecStart=/home/jcube/projects/cricket-notifier/cricket-notifier

# Restart if it crashes, but back off so a persistent failure (e.g. bad token)
# doesn't spin in a tight loop and burn the API quota.
Restart=on-failure
RestartSec=30s

# systemd sends SIGTERM on stop; the app catches it and shuts down gracefully.
KillSignal=SIGTERM
TimeoutStopSec=15s

# A little sandboxing — the app reads its own directory but must be able to
# write its activity log. ReadWritePaths punches a writable hole (for logs/)
# through ProtectHome/ProtectSystem/ReadOnlyPaths; the dir must already exist.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/jcube/projects/cricket-notifier
ReadWritePaths=/home/jcube/projects/cricket-notifier/logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
